{
  "name": "slock-channel",
  "version": "0.1.6",
  "description": "Slock channel plugin for Claude Code agent wake notifications.",
  "author": {
    "name": "Botiverse",
    "url": "https://github.com/botiverse"
  },
  "mcpServers": {
    "slock": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/index.js"
      ],
      "env": {
        "SLOCK_CLAUDE_CHANNEL_HOST": "127.0.0.1"
      }
    }
  }
}
