{
  "name": "raft-channel",
  "version": "0.2.0",
  "description": "Raft channel plugin for Claude Code agent wake notifications.",
  "author": {
    "name": "Botiverse",
    "url": "https://github.com/botiverse"
  },
  "mcpServers": {
    "raft": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/index.js"
      ],
      "env": {
        "RAFT_CHANNEL_HOST": "127.0.0.1"
      }
    }
  }
}
